# Get the token from @BotFather. NEVER commit the real .env file.
BOT_TOKEN=

# Public HTTPS URL where this server is reachable (Telegram requires HTTPS for Mini Apps)
WEBAPP_URL=https://your-domain.example

# Comma-separated Telegram user IDs that can open the admin panel
ADMIN_IDS=1895441858

# Postgres connection string. Neon: Dashboard → Connect → pooled (-pooler) URL + sslmode=require. Never commit it.
# Use the direct (non-pooler) URL only for pg_dump / migrations.
DATABASE_URL=

# Optional
PORT=3000
# Bot username without @ (looked up automatically if empty)
BOT_USERNAME=
# Hours without a move before a "your move" reminder is sent (default 6)
REMIND_AFTER_HOURS=6
# Default referral diamonds (inviter / invitee). Overridable in Admin → Shop.
# REFERRAL_REWARD=20
# REFERRAL_INVITEE_REWARD=10

# Optional: Upstash Redis REST (dedicated cache DB for THIS bot only — never reuse another app's Redis)
# Strongly recommended for ~2.5k live users (shared rate-limit + lobby/rankings cache across restarts)
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Scale knobs (defaults target ~2.5k concurrent Mini App users on one Node + Neon pooler)
# PG_POOL_MAX=20
# RATE_LIMIT_PER_MIN=240
# MAX_WS_CONNECTIONS=4000
# PRESENCE_WRITE_MS=15000
# USER_SYNC_MS=60000
# USER_MEMO_MS=2000
# SWEEPER_MS=4000
# CACHE_MEM_MAX=8000

# Optional: Supabase Storage for admin media (bucket name: media). Prefer service_role key — server only.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Workers: set WEBAPP_URL to the workers.dev (or custom) URL after API_ORIGIN points at Render.
# Worker var API_ORIGIN=https://your-service.onrender.com

